# Resend API key — sign up free at https://resend.com (use cosmichealthcares@gmail.com as the
# account email so the sandbox onboarding@resend.dev sender can deliver to it without a verified
# domain). Create the key under Resend → API Keys, then paste it here / in Netlify env vars.
RESEND_API_KEY=

# Optional overrides — defaults already point at the right addresses if left unset.
# CONTACT_TO_EMAIL=cosmichealthcares@gmail.com
# CONTACT_FROM_EMAIL=Cosmic HealthCare Solutions <onboarding@resend.dev>
